groups:
- name: prometheus/alerts/dnssec.rules
  rules:
  # The exporter makes a series absent when it cannot get an answer, so a short
  # `for` window would page on a single failed scrape. Keep the window long
  # enough to ride out a temporary resolver or network failure.
  - alert: DNSSECSignatureExpiration
    expr: dnssec_zone_record_days_left < 10
    for: 15m
    labels:
      urgency: immediate
    annotations:
      description: The DNSSEC signature for the {{$labels.record}} in {{$labels.zone}} type {{$labels.type}}) expires in {{$value}} day(s)
      title: The DNSSEC signature for the {{$labels.record}} in {{$labels.zone}} is expiring
  - alert: DNSSECSignatureInvalid
    expr: dnssec_zone_record_resolves == 0
    for: 15m
    labels:
      urgency: immediate
    annotations:
      description: The DNSSEC signature for the {{$labels.record}} in {{$labels.zone}} type {{$labels.type}}) on resolver {{$labels.resolver}} is invalid
      title: The DNSSEC signature for the {{$labels.record}} in {{$labels.zone}}  on resolver {{$labels.resolver}} is invalid
  - alert: DNSSECZoneTransferFailed
    expr: dnssec_zone_transfer_success == 0
    for: 15m
    labels:
      urgency: immediate
    annotations:
      description: The exporter could not transfer the zone {{$labels.zone}} from {{$labels.server}}. The signatures in this zone are not checked while the transfer fails.
      title: The zone transfer for {{$labels.zone}} is failing
  # A record that stops being reported entirely is not covered by the alerts
  # above, because they cannot match an absent series.
  - alert: DNSSECRecordMissing
    expr: absent(dnssec_zone_record_resolves)
    for: 15m
    labels:
      urgency: warning
    annotations:
      description: The DNSSEC exporter reported no records for 15 minutes. Check that the exporter runs and that its configuration file lists the expected records.
      title: The DNSSEC exporter is not reporting any records
  # The [[chains]] checks. A DS that matches no key on a server breaks
  # validation for every client that asks that server, even while resolvers
  # with a cached key still validate.
  - alert: DNSSECChainBroken
    expr: dnssec_chain_ds_match == 0
    for: 15m
    labels:
      urgency: immediate
    annotations:
      description: No DS record at the parent of {{$labels.zone}} matches a DNSKEY on {{$labels.server}} that validly signs the DNSKEY RRset.
      title: The DNSSEC chain of trust for {{$labels.zone}} is broken on {{$labels.server}}
  - alert: DNSSECChainSOASignatureInvalid
    expr: dnssec_chain_soa_signature_valid == 0
    for: 15m
    labels:
      urgency: immediate
    annotations:
      description: The SOA of {{$labels.zone}} on {{$labels.server}} has no valid signature from one of the zone's keys.
      title: The SOA signature of {{$labels.zone}} on {{$labels.server}} is invalid
  - alert: DNSSECChainQueryFailed
    expr: dnssec_chain_query_success == 0
    for: 15m
    labels:
      urgency: warning
    annotations:
      description: The exporter got no answer from {{$labels.server}} for {{$labels.zone}}. The chain is not checked on this server while the query fails.
      title: The chain check for {{$labels.zone}} cannot reach {{$labels.server}}
