[[records]]
  zone = "ietf.org"
  record = "@"
  type = "SOA"

[[records]]
  zone = "verisigninc.com"
  record = "@"
  type = "SOA"

# A zone is transferred with AXFR. The exporter reports the record in the zone
# whose signature expires first.

#[[zones]]
#  zone = "example.com"
#  # The server to transfer from. Defaults to the first -resolvers entry.
#  server = "ns1.example.com:53"
#  key = "mysecretkey."

# A key authenticates a zone transfer with TSIG. Give the key file the same
# protection as any other secret.

#[[keys]]
#  name = "mysecretkey."
#  algorithm = "hmac-sha256."
#  # From tsig-keygen(1)
#  secret = "mvgDxfYTSe8L+pp7h4r+PIeTc67YTPhGWZrhmIi2Rpo="

# A chain follows the chain of trust of one zone, from the DS records at the
# parent to the keys and signatures on each of the zone's servers. Every query
# goes straight to an authoritative server, no resolver is involved.

#[[chains]]
#  zone = "example.com"
#  # The authoritative servers of the parent zone, where the DS records live.
#  parent_servers = ["a.gtld-servers.net:53", "b.gtld-servers.net:53"]
#  # The authoritative servers of the zone itself.
#  servers = ["ns1.example.com:53", "ns2.example.com:53"]
